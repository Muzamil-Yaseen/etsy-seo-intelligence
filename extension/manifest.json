{
  "manifest_version": 3,
  "name": "Etsy SEO Intelligence & Downloader",
  "version": "1.0.0",
  "description": "1-Click HD Photo Downloader, 13 Tag Extractor, and SEO Inspector for Etsy listings.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.etsy.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.etsy.com/*",
    "http://localhost:*/*",
    "https://*/*"
  ]
}